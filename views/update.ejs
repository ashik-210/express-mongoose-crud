<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Page</title>

    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>
    <div class="w-full min-h-screen bg-zinc-900 p-10 text-white">
        <div class="h-20 bg-zinc-800 rounded-lg flex justify-between items-center px-10 mb-10">
            <h3 class="text-blue-400 text-3xl font-bold ">Employees Update Dashboard</h3>
            <a class="px-5 py-2 bg-zinc-900 text-red-500 rounded-lg" href="/read">Read Users</a>
        </div>

        <h1 class="text-3xl mb-3">Update User</h1>
        <form action="/update/<%= user.id %>" method="post" class="flex gap-3">
            <input class="px-5 py-2 border-2 border-zinc-700 outline-none rounded-lg" type="text" name="name"
                placeholder="name" value="<%= user.name %>">

            <input class="px-5 py-2 border-2 border-zinc-700 outline-none rounded-lg" type="email" name="email"
                placeholder="e-mail" value="<%= user.email %>">

            <input class="px-5 py-2 border-2 border-zinc-700 outline-none rounded-lg" type="text" name="image"
                placeholder="image-url" value="<%= user.image %>" >

            <input class="px-5 py-2 bg-blue-500 rounded-lg cursor-pointer" type="submit" value="Submit">
        </form>
    </div>
</body>

</html>