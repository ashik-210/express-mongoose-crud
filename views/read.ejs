<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Users Page</title>

    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>
    <div class="w-full min-h-screen bg-zinc-900 p-10 text-white">
        <div class="h-15 bg-zinc-800 rounded-lg flex justify-between items-center px-10 mb-10">
            <h3 class="text-orange-400 text-2xl font-bold ">Users Dashboard</h3>
            <a class="px-5 py-2 bg-zinc-900 text-blue-500 rounded-lg" href="/">Back-to-Home</a>
        </div>
        <h1 class="text-3xl mb-3">All Users</h1>
        <div class="users flex gap-3 flex-wrap">
            <% if(users.length > 0){%>
                <% users.forEach(function(user){%>
                <div class="user w-72 p-4 bg-zinc-800 rounded-lg">
                <div class="w-full h-72 rounded-lg bg-zinc-700 overflow-hidden">
                    <img class="h-full w-full object-cover object-top" src="<%= user.image %>" alt="">
                </div>
                <h3 class="text-xl mt-3 tracking-tighter"><%= user.name %></h3>
                <h5 class="text-zinc-500"><%= user.email %></h5>
                <div class="flex gap-3 mt-10">
                    <a class="text-blue-400" href="/edit/<%= user._id %>">Edit User</a>
                    <a class="text-red-500" href="/delete/<%= user._id %>">Delete User</a>
                </div>
            </div>
            <%}) %>    
            <%} else{%>
                <h3 class="text-zinc-500">no users yet</h3>    
            <%}%>


        </div>
    </div>
</body>

</html>